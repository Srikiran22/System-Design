{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Systems Knowledge Portal Entity",
  "type": "object",
  "required": ["id", "type", "title", "slug", "summary", "status", "sources", "lastReviewed"],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "enum": [
        "concept",
        "method",
        "tool",
        "role",
        "resource",
        "standard",
        "certification",
        "case-study",
        "learning-path",
        "exercise",
        "glossary",
        "metric",
        "architecture-decision",
        "practice-lab"
      ]
    },
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "level": {
      "enum": ["beginner", "intermediate", "advanced", "expert"]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parentIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "targetId"],
        "properties": {
          "type": {
            "type": "string"
          },
          "targetId": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "supports"],
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "supports": {
            "type": "string"
          },
          "quoteOrParaphrase": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "discovered",
        "triaged",
        "source_checked",
        "drafted",
        "technical_review",
        "published",
        "needs_review",
        "archived"
      ]
    },
    "lastReviewed": {
      "type": "string",
      "format": "date"
    },
    "reviewDue": {
      "type": "string",
      "format": "date"
    },
    "version": {
      "type": "string"
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issuer": {
      "type": "string"
    },
    "edition": {
      "type": "string"
    },
    "publicationDate": {
      "type": "string",
      "format": "date"
    },
    "jurisdiction": {
      "type": "string"
    },
    "applicability": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failureModes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assessmentType": {
      "type": "string"
    },
    "reviewFrequencyDays": {
      "type": "integer",
      "minimum": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "researchMethod": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "enum": ["high", "medium", "low"]
        }
      }
    }
  }
}
