# ==============================================================================
# System-Design (NEET) Environment Variables Template
# Copy to .env (never commit secrets). Client-exposed variables must start with VITE_.
# ==============================================================================

# --- Production / Cloud Persistence (Supabase / Lovable Cloud) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Authorization & Course Authoring RBAC (Server-Only) ---
# Comma-separated list of verified account emails granted full admin & course-authoring access.
ADMIN_EMAILS=

# --- Dynamic Curriculum & Local Dev Options (Server-Only) ---
# Set to "1" to boot an empty curriculum database with zero starter seed courses.
NEET_SKIP_DEFAULT_CURRICULUM_SEED=
# Optional custom SQLite file path for local development/testing.
SQLITE_DB_PATH=
# Optional 32+ character signing key for local dev sessions (ephemeral CSPRNG used if omitted).
LOCAL_DEV_AUTH_SECRET=

# --- Security Headers (Server-Only) ---
# Set to "0" to disable default Content-Security-Policy-Report-Only header if CDN manages CSP.
CSP_REPORT_ONLY=
